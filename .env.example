# ============================================================
# LUCKMI 环境变量模板 — 复制为 .env.local（本地）或填入 Vercel（生产）
# 带 NEXT_PUBLIC_ 前缀的变量会暴露到浏览器，其余仅服务端可见
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable / anon key（浏览器端使用，受 RLS 约束）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key（仅服务端，切勿加 NEXT_PUBLIC_ 前缀，切勿提交 git）
SUPABASE_SERVICE_ROLE_KEY=
# 数据库直连密码（仅迁移脚本 scripts/run-sql-migration.mjs 使用，Vercel 可不配）
SUPABASE_DB_PASSWORD=

# ---- 应用 ----
# 生产填正式域名，如 https://luckmi.app；本地留空时代码回退 http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Creem（Merchant of Record）----
# 测试: creem_test_...（test-api.creem.io）；生产: creem_live_...（api.creem.io）
CREEM_API_KEY=
# Creem Dashboard → Settings → Webhooks 的签名密钥（HMAC-SHA256 验签）
CREEM_WEBHOOK_SECRET=

# ---- Creem product_id（Dashboard 创建商品后获取；test/live 各一套）----
CREEM_PRODUCT_QUICK_FIRST=
CREEM_PRODUCT_QUICK_REPEAT=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_ANNUAL_REPORT=
CREEM_PRODUCT_CONSULT_WA=
